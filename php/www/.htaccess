# Pas de listing des dossiers
Options -Indexes
DirectoryIndex index.php

# Types utiles à WinWeb (SQLite en WebAssembly, applications .wapp)
AddType application/wasm .wasm
AddType application/zip .wapp
AddType text/javascript .js .mjs

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Le service worker doit toujours être relu (mises à jour)
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Fichiers cachés (.git, .env...) jamais servis
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
